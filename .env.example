# Core
NODE_ENV=development
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
REDIS_URL=redis://localhost:6379
KORA_APP_URL=http://localhost:3000
KORA_TENANT_ID=ten_acme

# Auth
BETTER_AUTH_SECRET=change-me-to-32-plus-random-bytes-please
BETTER_AUTH_URL=http://localhost:3000
KORA_SEED_OPERATOR_EMAIL=operator@acme.test
KORA_SEED_OPERATOR_PASSWORD=operator-password

# Models
KORA_MODEL_PROVIDER=mock
KORA_MODEL_AGENT=mock-agent
KORA_MODEL_CLASSIFIER=mock-classifier
KORA_MODEL_EMBEDDING=mock-embedding
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Acme mock commerce

# Agent behaviour
KORA_MAX_STEPS=8
KORA_RUN_DEADLINE_MS=45000
KORA_CONFIDENCE_THRESHOLD=0.7
KORA_APPROVAL_TTL_MINUTES=60
KORA_DEPLOYMENT_MODE=full

# Observability
LOG_LEVEL=info

# Set LOG_PRETTY=true for human-readable CLI logs. It uses a worker thread, so
# leave it off inside Next.
LOG_PRETTY=false

# Evaluation. The judge must be a different model family than the agent.
KORA_MODEL_JUDGE=mockjudge-v1
KORA_JUDGE_SAMPLE_RATE=0.2
KORA_RUBRIC_VERSION=support-v1

# Runtime connection. A non-superuser role, so row-level security is enforced.
# Migrations keep using DATABASE_URL as the owner.
DATABASE_APP_URL=postgresql://kora_app:kora_app@localhost:5432/kora

# Encrypts business API credentials at rest.
KORA_SECRET_KEY=kora-development-secret-key-change-me
KORA_RETENTION_DAYS=90

# Stripe webhook endpoint secret (Stripe dashboard -> webhooks -> signing secret).
# Either the raw `whsec_…` value or a `v1.…` blob produced by encryptSecret.
STRIPE_WEBHOOK_SECRET=

# Stripe billing (test mode only). The dev key below is deliberately empty: it
# is a broad test-mode key used only by scripts/stripe-fixtures.mts, never
# committed with a real value, never logged. Runtime keys are per-tenant,
# encrypted in tenant_settings, set via `pnpm kora stripe:set-key`.
STRIPE_DEV_KEY=
STRIPE_TENANT_KEY=
STRIPE_FIXTURE_FROZEN_TIME=
STRIPE_PRICE_BASIC=price_test_basic_placeholder
STRIPE_PRICE_PRO=price_test_pro_placeholder
KORA_REFUND_WINDOW_DAYS=30
