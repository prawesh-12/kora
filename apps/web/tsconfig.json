{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // These two are off for the web app only.
    //
    // Vendored registry components from shadcn, beUI and ReUI are not written
    // against either flag. With both on, tsc reports 87 errors, every one of
    // them in code we did not write and are told not to modify. The alternative
    // is surgery on vendored components, which is the signal that the wrong
    // component was picked.
    //
    // The cost is real: this app loses the compiler's help on optional
    // properties and array indexing. Every package holding business logic keeps
    // both flags on, which is where that help is worth most. See
    // tsconfig.base.json and docs/decisions.md.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    // These two are off for the web app only.
    //
    // Vendored registry components from shadcn, beUI and ReUI are not written
    // against either flag, and together they produce around sixty errors in
    // code we did not write and are told not to modify. The alternative is
    // surgery on vendored components, which is the signal that the wrong
    // component was picked.
    //
    // The cost is real: this app loses the compiler's help on optional
    // properties and array indexing. Every package that holds business logic
    // keeps both flags on, which is where that help is worth most. See
    // tsconfig.base.json and docs/decisions.md.
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
